{
  "name": "mohamed_tayeb",
  "version": "1.0.0",
  "main": "main.js",

  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "dist": "electron-builder"
  },

  "build": {
    "appId": "com.mohamed_tayeb.id",
    "productName": "mohamed tayeb School",

    "files": [
      "main.js",
      "frontend/**/*"
    ],

    "win": {
      "icon": "assets/logoWithOutBg.png",
      "target": "nsis"
    },

    "nsis": {
      "oneClick": true,
      "artifactName": "${name}-Setup-${version}.${ext}"
    },

    "mac": {
      "icon": "assets/logoWithOutBg.png"
    },

    "linux": {
      "icon": "assets/logoWithOutBg.png",
      "target": "AppImage",
      "category": "Education"
    },

    "publish": [
      {
        "provider": "github",
        "owner": "mohamedtayeb1129-commits",
        "repo": "desktop",
        "releaseType": "release"
      }
    ]
  },

  "author": "Mohamed Tayeb",
  "license": "ISC",
  "description": "School management desktop application",

  "dependencies": {
    "electron-updater": "^6.8.9"
  },

  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  }
}